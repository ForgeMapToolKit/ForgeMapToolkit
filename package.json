{
  "name": "ForgeMapToolkit",
  "version": "0.1.0-beta.1",
  "description": "Advanced Mapping Toolkit",
  "main": "electron/main.js",
  "bin": {
  "fmt": "electron/cli.js"
},
  "scripts": {
    "dev": "vite",
    "prebuild": "node utils/generate-csp-hashes.js",
    "build": "vite build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run build && electron-builder",
    "preview": "vite preview",
    "release:beta": "standard-version --prerelease beta",
    "release": "standard-version"
  },
  "dependencies": {
    "@uiw/react-color": "^2.9.6",
    "adm-zip": "^0.5.16",
    "framer-motion": "^12.40.0",
    "highlight.js": "^11.11.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.24",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^40.4.0",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.16",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ForgeMapToolkit.app",
    "productName": "ForgeMapToolkit",
    "forceCodeSigning": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "data/**/*",
      "utils/**/*"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "signtoolOptions": {
        "sign": "./build/skip-sign.js"
      },
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/assets/icons/App/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/assets/icons/App/icon.png"
    }
  }
}
